generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MenuCategory {
  FOOD
  DRINK
  ROOM
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model MenuItem {
  id        String           @id @default(uuid())
  name      String
  price     Decimal          @db.Decimal(10, 2)
  category  MenuCategory

  // Keep these for now.
  // We will migrate their data before removing them.
  imageUrl  String?
  publicId  String?

  images    MenuItemImage[]

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([category])
  @@map("menu_items")
}

model MenuItemImage {
  id         String   @id @default(uuid())
  url        String
  publicId   String
  menuItemId String
  order      Int      @default(0)

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("menu_item_images")
}